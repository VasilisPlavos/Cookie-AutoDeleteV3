{
  "name": "cookie-autodelete-v3",
  "version": "1.3.2",
  "description": "Chrome browser extension that auto-deletes unwanted cookies and site data",
  "keywords": [
    "cookie",
    "browser cookies",
    "browser webextension",
    "webextension",
    "extension"
  ],
  "scripts": {
    "build": "npm run compile && node ./tools/buildFilesDev.js",
    "build:chrome": "node ./tools/buildChrome.js",
    "build:firefox": "npm run compile && node ./tools/buildFilesDev.js --target=firefox",
    "compile": "webpack --config webpack.config.js --color",
    "dev": "webpack --config webpack.config.js --progress --color --watch",
    "lint": "eslint -c .eslintrc.json --max-warnings 0 --ext .ts src/",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:perf": "jest --testPathIgnorePatterns=/node_modules/ --runInBand -- __tests__/perf",
    "test-all": "npm run test && npm run lint"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=8.5.0"
  },
  "private": true,
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.2.1",
    "@fortawesome/free-regular-svg-icons": "^6.2.1",
    "@fortawesome/free-solid-svg-icons": "^6.2.1",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "ipaddr.js": "^2.4.0",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-redux": "^7.2.9",
    "redux": "^4.2.0",
    "redux-thunk": "^2.4.2",
    "redux-webext": "^1.1.2",
    "shortid": "^2.2.16",
    "webextension-polyfill": "^0.8.0"
  },
  "devDependencies": {
    "@types/firefox-webext-browser": "^143.0.0",
    "@types/jest": "^30.0.0",
    "@types/jest-when": "^3.5.2",
    "@types/react": "^17.0.52",
    "@types/react-dom": "^17.0.18",
    "@types/react-redux": "^7.1.24",
    "@types/redux-thunk": "^2.1.0",
    "@types/shortid": "0.0.29",
    "@typescript-eslint/eslint-plugin": "^4.33.0",
    "@typescript-eslint/parser": "^4.33.0",
    "ajv": "^8.20.0",
    "archiver": "^5.3.1",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^63.0.2",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "eslint-plugin-react": "^7.37.5",
    "jest": "^30.4.2",
    "jest-date-mock": "^1.0.8",
    "jest-environment-jsdom": "^30.0.0",
    "jest-when": "^4.0.3",
    "js-yaml": "^3.14.2",
    "prettier": "^2.8.1",
    "source-map-loader": "^5.0.0",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.4.2",
    "typescript": "^4.9.4",
    "webpack": "^5.75.0",
    "webpack-bundle-analyzer": "^5.3.0",
    "webpack-cli": "^4.10.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vasilisplavos/Cookie-AutoDeleteV3.git"
  },
  "author": "Vasilis Plavos",
  "contributors": [
    {
      "name": "Vasilis Plavos",
      "url": "https://github.com/vasilisplavos"
    }
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/vasilisplavos/Cookie-AutoDeleteV3/issues"
  },
  "homepage": "https://github.com/vasilisplavos/Cookie-AutoDeleteV3#readme"
}
